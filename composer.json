{
    "name": "hubsys/hubpay-sdk",
    "description": "Oficjalny PHP SDK + WooCommerce gateway do integracji z bramką płatności HubPay (Hubsys).",
    "keywords": ["hubsys", "hubpay", "payment-gateway", "sdk", "php", "woocommerce", "polish-payments", "HUB"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "autoload": {
        "psr-4": {
            "Hubsys\\HubPay\\Sdk\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/HubsysPL/hubpay-sdk/issues",
        "source": "https://github.com/HubsysPL/hubpay-sdk"
    },
    "authors": [
        {
            "name": "Hubsys Engineering",
            "homepage": "https://hubsys.pl"
        }
    ]
}
